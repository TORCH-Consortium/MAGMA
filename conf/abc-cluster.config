/*
 * abc-cluster.config — execute MAGMA on the abc-cluster platform via the
 *                      nf-nomad executor (HashiCorp Nomad backend).
 *
 *   abc pipeline run https://github.com/TORCH-Consortium/MAGMA \
 *     --revision feature/abc-cluster \
 *     --profile  test,abc_cluster
 *
 * What this profile does
 *  - Pins every process to a container image (same registry refs as
 *    `conf/docker.config`, so cross-runtime: abc-cluster's nf-nomad
 *    will pick the configured container driver — `containerd-driver`
 *    by default, with `podman` / `apptainer` available — and pull the
 *    image accordingly).
 *  - Does NOT set `docker { enabled = true }`. The abc-cluster
 *    nf-nomad pathway runs each process inside a Nomad task whose
 *    container is the image below; wrapping the command in `docker
 *    run` (what `docker.enabled` does) would double-wrap and fail.
 *  - Does NOT set executor / workDir / nomad { ... } / aws { ... } —
 *    those are injected by `abc pipeline run` as an override config
 *    on top of this one (see abc-cluster-cli internal/hclgen/pipeline).
 *
 * Companion profiles
 *  - Combine with `test` to use the bundled 3-sample SRA dataset:
 *      -profile test,abc_cluster
 *  - Combine with `low_memory` if your cluster nodes have <16 GiB:
 *      -profile test,abc_cluster,low_memory
 *
 * Source: brainstorms/torch-magma-on-abc-cluster (abc-universe), 2026-06-03.
 */

// -----------------------------------------------------------------------------
// Publish mode: copy (not the default 'symlink').
//
// On abc-cluster the results dir (params.outdir, injected by `abc pipeline run`)
// is always an s3:// URI. Nextflow's publishDir cannot symlink to an S3 target,
// so with the pipeline default `save_mode = 'symlink'` (default_params.config)
// every publish logs:
//   WARN: Cannot use mode `symlink` to publish files to path: … -- Using mode `copy` instead
// and silently falls back to copy. Results DO reach S3 either way, but set copy
// explicitly so the publish is correct-by-construction and the log is clean.
// -----------------------------------------------------------------------------
params {
    save_mode = 'copy'
}

process {

    // -----------------------------------------------------------------------
    // Per-process container assignments (mirrors conf/docker.config).
    //
    // Container images are the same biocontainers / GHCR tags used by the
    // pipeline's `docker`, `singularity`, `apptainer`, `podman` profiles.
    // nf-nomad picks the runtime via cluster-side driver capability
    // discovery — `abc pipeline run --apptainer` / `--singularity`
    // overrides the choice if needed.
    // -----------------------------------------------------------------------

    withName: '.*SPOTYPING.*' {
        container = "quay.io/biocontainers/spotyping:2.1--hdfd78af_4"
    }

    withName: '.*RDANALYZER.*' {
        container = "quay.io/biocontainers/rd-analyzer:1.01--hdfd78af_0"
    }

    withName: '.*TBPROFILER.*' {
        container = "ghcr.io/torch-consortium/magma/biocontainer-tbprofiler:6.3.0--1"
    }

    withName: 'NTMPROFILER.*' {
        container = "ghcr.io/torch-consortium/magma/biocontainer-ntmprofiler:0.4.0"
    }

    withName: 'ISMAPPER.*|GATK.*|LOFREQ.*|DELLY.*|MULTIQC.*|FASTQC.*|UTILS.*|FASTQ.*|SAMPLESHEET.*' {
        container = "ghcr.io/torch-consortium/magma/magma-container-1:2.0.0"
    }

    withName: 'BWA.*|IQTREE.*|SNPDISTS.*|SNPSITES.*|BCFTOOLS.*|BGZIP.*|SAMTOOLS.*|SNPEFF.*|CLUSTERPICKER.*' {
        container = "ghcr.io/torch-consortium/magma/magma-container-2:1.1.1"
    }

    // -----------------------------------------------------------------------
    // Resource requests for the CPU-bound long-pole processes.
    //
    // Without explicit cpus/memory, nf-nomad submits each child task with
    // Nomad's minimal default reservation, so the scheduler over-packs many
    // CPU-heavy tasks onto a single seedling compute node and starves them.
    // Observed 2026-06-03: GATK_HAPLOTYPE_CALLER ran 2h+ (vs ~20m for a
    // sibling sample) when co-scheduled with DELLY / BWA_MEM under
    // queueSize = 20, which blocked the cohort gather (MERGE_WF) from ever
    // triggering.
    //
    // Declaring real reservations makes Nomad reserve CPU per task and stop
    // co-locating heavy tasks. Values are sized to fit ONE seedling node
    // (~4 cores / ~8 threads / ~7.7 GiB) — conf/server.config's larger
    // values (BWA_MEM cpus = 9, default cpus = 8 / 14.GB) target a single fat
    // server and would fail to place on the seedling tier. Patterns match the
    // trailing process name so every sub-workflow invocation is covered
    // (CALL_WF, MAP_WF, STRUCTURAL_VARIANTS_ANALYSIS_WF, …), unlike
    // server.config's `WF:NAME` form which pins to one sub-workflow.
    // -----------------------------------------------------------------------

    withName: '.*GATK_HAPLOTYPE_CALLER' {
        cpus   = 4
        memory = 4.GB
    }

    withName: '.*BWA_MEM.*' {
        cpus   = 4
        memory = 6.GB
    }

    withName: '.*GATK_MARK_DUPLICATES.*' {
        cpus   = 2
        memory = 4.GB
    }

    // -----------------------------------------------------------------------
    // Keep DELLY_CALL off preemptible (GCP spot) nodes.
    //
    // DELLY scans the entire sorted BAM (minutes), then writes a single small
    // .delly.bcf. A spot reclaim during that window forces a retry — wasteful,
    // and historically surfaced as "Missing output file(s)" when the node was
    // reclaimed mid push-back (now retried cleanly by nf-nomad-s5cmd >= 0.1.4,
    // but still cheaper to avoid). Spot nodes carry node.class = "gcp-spot"
    // (same discriminator the platform's Alloy / JuiceFS jobs exclude on), so
    // constrain DELLY to the stable pool. Closure form is required because the
    // `!=` operator isn't expressible via the map/`class` shorthand.
    withName: '.*DELLY_CALL.*' {
        nomad = [ constraints: { node { raw('class', '!=', 'gcp-spot') } } ]
    }

    // -----------------------------------------------------------------------
    // Retry on transient failures (Nomad placement timeouts, network
    // hiccups on container pull, etc.). The pipeline already sets
    // errorStrategy globally; this just ensures `nomad` placement failures
    // ride the same retry budget rather than aborting the whole DAG.
    // -----------------------------------------------------------------------

    errorStrategy = { task.attempt < 3 ? 'retry' : 'ignore' }
    maxRetries    = 3
}

// -----------------------------------------------------------------------------
// Executor pool sizing
//
// nf-nomad submits one Nomad job per process. queueSize gates how many are
// in flight simultaneously. The per-process resource reservations above now
// do the real CPU gating (Nomad won't over-pack heavy tasks), so this is a
// Nextflow-side submission ceiling: 8 keeps the seedling compute pool busy
// without flooding it with pending submissions (20 starved HAPLOTYPE_CALLER
// on 2026-06-03). Tune up for a multi-node grove / cloud deployment.
// -----------------------------------------------------------------------------
executor {
    queueSize = 8
}
